@using FrontEndMediClock.Modelos
@using FrontEndMediClock.Servicios
@inject ApiMediClock Api
@inject EstadoDispositivo Estado
@inject PreferenciasLocales Prefs
@implements IDisposable

@* Selector minimo de dispositivo: lista real del backend y guarda la
   seleccion en EstadoDispositivo para que T4/T5 la reutilicen.
   Cada opcion muestra el alias solo-front cuando existe,
   ej. "Probando (id=1)"; si no hay alias, nombre del servidor. *@

@if (cargando)
{
    <p>Cargando dispositivos...</p>
}
else if (error is not null)
{
    <p style="color:red">@error</p>
}
else
{
    <label>
        Dispositivo:
        <select value="@Estado.DispositivoId" @onchange="AlCambiar">
            @foreach (var d in dispositivos)
            {
                <option value="@d.dispositivoId">@TextoOpcion(d)</option>
            }
        </select>
    </label>
}

@code {
    private List<Dispositivo> dispositivos = new();
    private bool cargando = true;
    private string? error;

    // Alias solo-front por dispositivoId (localStorage).
    private Dictionary<int, string> aliases = new();

    protected override async Task OnInitializedAsync()
    {
        Estado.Cambio += AlCambiarEstado;
        try
        {
            dispositivos = await Api.ListarDispositivos();
            // Si el default (id=1) no existe en la lista, se usa el primero.
            if (dispositivos.Count > 0 && dispositivos.All(d => d.dispositivoId != Estado.DispositivoId))
            {
                Estado.Seleccionar(dispositivos[0].dispositivoId);
            }
            await CargarAliases();
        }
        catch (ExcepcionApi ex)
        {
            error = string.Join(" ", ex.Mensajes);
        }
        finally
        {
            cargando = false;
        }
    }

    // Recarga los alias cuando otro componente avisa (ej. guardar alias).
    private async void AlCambiarEstado()
    {
        await CargarAliases();
        StateHasChanged();
    }

    private async Task CargarAliases()
    {
        foreach (var d in dispositivos)
        {
            var alias = await Prefs.ObtenerAlias(d.dispositivoId);
            if (string.IsNullOrWhiteSpace(alias))
            {
                aliases.Remove(d.dispositivoId);
            }
            else
            {
                aliases[d.dispositivoId] = alias.Trim();
            }
        }
    }

    // Texto de cada opcion: alias cuando existe, si no nombre del servidor.
    private string TextoOpcion(Dispositivo d) =>
        aliases.TryGetValue(d.dispositivoId, out var alias)
            ? $"{alias} (id={d.dispositivoId})"
            : $"{d.nombre} (id={d.dispositivoId})";

    private void AlCambiar(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            Estado.Seleccionar(id);
        }
    }

    public void Dispose()
    {
        Estado.Cambio -= AlCambiarEstado;
    }
}
